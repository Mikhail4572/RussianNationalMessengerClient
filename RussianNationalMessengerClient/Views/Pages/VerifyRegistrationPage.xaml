<UserControl x:Class="RussianNationalMessengerClient.Views.Pages.VerifyRegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RussianNationalMessengerClient.Views.Pages"
      mc:Ignorable="d" Background="white"
      d:DesignHeight="450" d:DesignWidth="800">

    <Grid ColumnDefinitions="1*, 2.5*, 1*" >
        <Grid VerticalAlignment="Center" RowDefinitions="auto auto auto" Grid.Column="1">
            <Label Margin="0 0 0 5" Content="Подтверждение почты" FontSize="30" HorizontalContentAlignment="Center"/>
            <Label Content="Код с почты(проверьте спам)" Grid.Row="1"/>
            <TextBox Grid.Row="2" Text="{Binding Code}"/>
        </Grid>
    </Grid>
</UserControl>
