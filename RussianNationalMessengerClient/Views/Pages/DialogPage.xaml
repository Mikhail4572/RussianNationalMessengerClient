<UserControl x:Class="RussianNationalMessengerClient.Views.Pages.DialogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:RussianNationalMessengerClient.Views.Pages"
      xmlns:vm="clr-namespace:RussianNationalMessengerClient.ViewModels"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      xmlns:models="clr-namespace:RussianNationalMessengerClient.Models"
      xmlns:uimodels="clr-namespace:RussianNationalMessengerClient.Models.UIModels"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:RussianNationalMessengerClient.Converters"
      xmlns:views="clr-namespace:RussianNationalMessengerClient.Views.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"> 
    <UserControl.Resources>
        <converters:ViewAttachmentConverter x:Key="viewAttachmentConverter"/>
    </UserControl.Resources>

    <Grid Background="#f1f1f1" RowDefinitions="auto, *, auto, auto">
        <Grid RowDefinitions="*, auto" Margin="5 5 0 0">
            <!--Имя собеседника или название группы-->
            <Label Content="{Binding DisplayName}" Foreground="#000" FontSize="15"/>
            <!--Онлайн ли?-->
            <Label Content="тест" Grid.Row="1" Foreground="#000"/>
        </Grid>

        <!--Чат-->
        <ListView Grid.Row="1" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource TransparentListViewItemStyle}"
                  x:Name="LvMessages" ItemsSource="{Binding Messages}" Style="{StaticResource LvNoneErrorTemplate}" ScrollViewer.CanContentScroll="False"
                  SelectedItem="{Binding SelectedMessage}" BorderThickness="1 0 0 0">

            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDoubleClick">
                    <i:InvokeCommandAction Command="{Binding OpenAttachmentWindowCommand}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>

            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Удалить" Command="{Binding RemoveMessageCommand}"/>
                    <MenuItem Header="Копировать" Command="{Binding CopyChatCommand}"/>
                </ContextMenu>
            </ListView.ContextMenu>
            
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type uimodels:UIMessage}">
                    <Border HorizontalAlignment="Left" BorderThickness="1" Padding="3" Margin="10 5 0 0"
                            CornerRadius="8" BorderBrush="#F1F1F1" Background="#d2e3fc">
                        <Grid HorizontalAlignment="Center" RowDefinitions="auto, auto, *, auto" MaxWidth="400">
                            
                            <TextBlock Foreground="Gray" Text="{Binding Author}" FontSize="12"/>

                            <ItemsControl  Grid.Row="1" ItemsSource="{Binding Attachments}"
                                           BorderThickness="0" ItemTemplate="{StaticResource LvAttachmentsTemplate}">
                            
                            </ItemsControl>

                            <TextBox TextWrapping="Wrap"
                                     IsReadOnly="True"
                                     Text="{Binding Content}"
                                     Grid.Row="2" FontSize="13">
                                
                                <TextBox.Resources>
                                    <Style TargetType="TextBox">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <Label Grid.Row="3" Foreground="lightgray" FontSize="10" Content="{Binding SentAtFormat}"/>
                        </Grid>
                    </Border>            
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--Вложения-->
        <ListView Grid.Row="2" ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0"
                 ItemsSource="{Binding LoadAttachments}" Margin="0 10" ItemContainerStyle="{StaticResource TransparentListViewItemStyle}">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Height="50" Width="50" CornerRadius="8" BorderBrush="gray" Margin="0 0 5 0" BorderThickness="0.1">
                        <Label HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                               Content="{Binding ., Converter={StaticResource viewAttachmentConverter}}"/>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
        <Grid Grid.Row="3" ColumnDefinitions="auto, *, auto" Margin=" 0 5 5 5">
            <ui:Button Command="{Binding AddAttachment}" Icon="{ui:SymbolIcon Attach12}" FontSize="16" BorderThickness="0" Background="Transparent"/>

            <TextBox Text="{Binding Content}" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                     FontSize="16" Padding="5" Margin="0 0 15 0" MaxHeight="100">
                
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SendMessageCommand}" />
                    <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteImageCommand}" />
                </TextBox.InputBindings>

            </TextBox>

            <!--<Button Content="Отправить" Command="{Binding SendMessageCommand}"
                    VerticalAlignment="Bottom" IsEnabled="{Binding IsSendButtonEnabled}"
                    Grid.Column="2" Padding="7"/>-->

            <ui:Button Command="{Binding SendMessageCommand}" Icon="{ui:SymbolIcon Send24}"
                    VerticalAlignment="Bottom" IsEnabled="{Binding IsSendButtonEnabled}"
                    Grid.Column="2" Padding="10" FontSize="14"/>
        </Grid>
    </Grid>
</UserControl>
