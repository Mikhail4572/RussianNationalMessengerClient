<UserControl x:Class="RussianNationalMessengerClient.Views.Pages.DialogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:RussianNationalMessengerClient.Views.Pages"
      xmlns:vm="clr-namespace:RussianNationalMessengerClient.ViewModels"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      xmlns:models="clr-namespace:RussianNationalMessengerClient.Models"
      xmlns:converters="clr-namespace:RussianNationalMessengerClient.Converters"
      xmlns:views="clr-namespace:RussianNationalMessengerClient.Views.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"> 
    <UserControl.Resources>
        <converters:ViewAttachmentConverter x:Key="viewAttachmentConverter"/>
    </UserControl.Resources>

    <Grid Background="#f1f1f1" RowDefinitions="auto, *, auto, auto">
        <Grid ColumnDefinitions="auto, *">
            <Grid RowDefinitions="*, auto">
                <!--Имя собеседника-->
                <Label Content="{Binding DisplayName}" FontSize="15"/>
                <!--Онлайн ли?-->
                <Label Content="тест" Grid.Row="1" HorizontalContentAlignment="Right"/>
            </Grid>
        </Grid>
        
        <!--Чат-->
        <ListView Grid.Row="1" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource TransparentListViewItemStyle}"
                  x:Name="LvMessages" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}"
                  ScrollViewer.CanContentScroll="False">
           
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border HorizontalAlignment="Left" BorderThickness="1" Padding="3" Margin="10 5 0 0"
                            CornerRadius="8" BorderBrush="#F1F1F1" Background="#effdde">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Удалить" Click="MenuItemRemoveMessage_Click"/>
                                <MenuItem Header="Копировать" Command="{Binding DataContext.CopyChatCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                <!--<MenuItem Header="Копировать" Click="MenuItemCopyMessage_Click"/>-->
                                <!--<MenuItem Header="Копировать" Command="{Binding DataContext.CopyChatCommand, 
                                    RelativeSource={RelativeSource AncestorType=ListView}}"/>-->
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid HorizontalAlignment="Center" RowDefinitions="auto, auto, *, auto" MaxWidth="400">
                            <ListBox ItemsSource="{Binding Attachments}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Attachment}">
                                        <!--написать отображение полученных вложений-->
                                        <Grid>
                                            <Border>
                                                <Label Content="{Binding GetExtension}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Grid.Row="1" Foreground="Gray" Text="{Binding Author}" FontSize="12"/>
                            <TextBox TextWrapping="Wrap"
                                     IsReadOnly="True"
                                     Text="{Binding Content}"
                                     Grid.Row="2" FontSize="13">
                                
                                <TextBox.Resources>
                                    <Style TargetType="TextBox">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <Label Grid.Row="3" Foreground="lightgray" FontSize="10" Content="{Binding SentAtFormat}"/>
                        </Grid>
                    </Border>            
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--Вложения-->
        <ListBox Grid.Row="2" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 ItemsSource="{Binding LoadAttachments}" Margin="0 10">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Height="50" Width="50" CornerRadius="8" BorderBrush="gray" Margin="0 0 5 0" BorderThickness="0.1">
                        <Label HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                               Content="{Binding ., Converter={StaticResource viewAttachmentConverter}}"/>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <Grid Grid.Row="3" ColumnDefinitions="auto, *, auto" Margin=" 0 5 5 5">

            <Button Command="{Binding AddAttachment}">
                <Button.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="5"/>
                    </Style>
                </Button.Resources>                
                <Button.Content>
                    <svgc:SvgViewbox Source="/Icons/attachFile.svg" 
                        Height="20" Width="20" Stretch="Uniform"/>
                </Button.Content>
            </Button>
            
            <TextBox Text="{Binding Content}" Grid.Column="1" VerticalAlignment="Center"
                     FontSize="15" Padding="2" Margin="0 0 15 0" MaxHeight="100">

                <TextBox.InputBindings>
                    <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteContentCommand}" />
                    <KeyBinding Key="Enter" Command="{Binding SendMessageCommand}" />
                </TextBox.InputBindings>

            </TextBox>

            <Button Content="Отправить" Command="{Binding SendMessageCommand}" VerticalAlignment="Bottom"
                    Grid.Column="2" Padding="7"/>
        </Grid>
    </Grid>
</UserControl>
