<UserControl x:Class="RussianNationalMessengerClient.Views.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="clr-namespace:RussianNationalMessengerClient.Helpers"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      xmlns:local="clr-namespace:RussianNationalMessengerClient.Views.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="400">

    <Grid Background="white" ColumnDefinitions="1*, 2.5*, 1*"
          RowDefinitions="auto, *">
      
        <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
              RowDefinitions="auto, auto, auto, auto, auto, auto, auto, auto">
            <Label Margin="0 0 0 5" Content="Вход" FontSize="30" HorizontalContentAlignment="Center"/>
            <Label Margin="0 0 0 5" FontSize="15" Grid.Row="1" Content="Логин"/>
            <TextBox Margin="0 0 0 5" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2"/>
            <Label Margin="0 0 0 5" FontSize="15" Grid.Row="3" Content="Пароль"/>
            
            <ui:PasswordBox Margin="0 0 0 5"
                            Password="{Binding Password, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                            Grid.Row="4" RevealButtonEnabled="True"/>
            
            <Button Command="{Binding LoginCommand}" Content="Войти" Grid.Row="5" HorizontalAlignment="Center"/>
            <ProgressBar Value="{Binding Value}" Maximum="100" Minimum="0" Height="10" Grid.Row="6" Margin="0 0 0 5"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="red" TextWrapping="Wrap" Grid.Row="7" />
        </Grid>

    </Grid>
</UserControl>
