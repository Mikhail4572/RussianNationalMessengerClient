<Window x:Class="RussianNationalMessengerClient.Views.Windows.AttachmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:local="clr-namespace:RussianNationalMessengerClient.Views.Windows"
        xmlns:converters="clr-namespace:RussianNationalMessengerClient.Converters"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:RussianNationalMessengerClient.ViewModels"
        mc:Ignorable="d" WindowState="Maximized" WindowStyle="None" 
        AllowsTransparency="True" MinHeight="350" MinWidth="700" 
        Background="#CC202020" WindowStartupLocation="CenterScreen"
        Title="" Height="450" Width="800">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="booltovisConverter"/>
        <converters:BoolToVisibilityReverseConverter x:Key="booltovisReverseConverter"/>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Left" Command="{Binding LastCommand}"/>
        <KeyBinding Key="Right" Command="{Binding NextCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseWindowCommand}" />
    </Window.InputBindings>
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Сохранить" Command="{Binding SaveCommand}"/>
            <MenuItem Header="Копировать" Command="{Binding CopyImageCommand}" 
                      Visibility="{Binding Attachment.IsImage, Converter={StaticResource booltovisConverter} }"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid RowDefinitions="auto *">

        <Grid Grid.RowSpan="2">
            <Image Source="{Binding Attachment.Preview}" Visibility="{Binding Attachment.IsImage, 
                Converter={StaticResource booltovisConverter}}"/>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10 5" 
                    CornerRadius="8" BorderBrush="#aaa" BorderThickness="2" Visibility="{Binding Attachment.IsImage,
                    Converter={StaticResource booltovisReverseConverter}}">

                <Grid ColumnDefinitions="auto *">
                    <ui:SymbolIcon Symbol="Document16" FontSize="20" Foreground="LightGray"/>
                    <ui:TextBlock FontSize="20" Grid.Column="1" Foreground="#aaa" Text="{Binding Attachment.FileName}" />
                </Grid>
            </Border>
        </Grid>

        <ui:SymbolIcon Symbol="ChevronLeft12" Foreground="gray" FontSize="20" Margin="10 0 0 0" 
                       VerticalAlignment="Center" HorizontalAlignment="Left" Grid.RowSpan="2">
            
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseUp">
                    <i:InvokeCommandAction Command="{Binding LastCommand}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </ui:SymbolIcon>

        <ui:SymbolIcon Margin="0 0 10 0" Symbol="ChevronRight12" Foreground="gray" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.RowSpan="2">
                
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseUp">
                    <i:InvokeCommandAction Command="{Binding NextCommand}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </ui:SymbolIcon>

        <Grid>
            <ui:SymbolIcon HorizontalAlignment="Right" Margin="0 10 10 0"
                           Symbol="Dismiss48" FontSize="20" Foreground="LightGray">
                
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseUp">
                        <i:InvokeCommandAction Command="{Binding CloseWindowCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ui:SymbolIcon>
        </Grid>
    </Grid>
</Window>
