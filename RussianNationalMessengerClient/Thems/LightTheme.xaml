<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:converters="clr-namespace:RussianNationalMessengerClient.Converters"
                    xmlns:uimodels="clr-namespace:RussianNationalMessengerClient.Models.UIModels"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>    

    <Style TargetType="{x:Type ListView}" x:Key="LvNoneErrorTemplate">
        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
            
    <DataTemplate x:Key="LvAttachmentsTemplate" DataType="{x:Type uimodels:UIMessageAttachment}">
        <Border BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="6"
                    Margin="0 4">

            <Grid ColumnDefinitions="auto, *">
                <!-- Превью изображения -->
                <Image Source="{Binding Preview}"
                           Width="100"
                           Height="75"
                           Stretch="Uniform"
                           Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Информация о файле -->
                <StackPanel Grid.Column="1" Margin="8 0" >
                    <TextBlock Text="{Binding FileName}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding SizeFormat}"
                                   Foreground="Gray"
                                   FontSize="11"/>

                    <!--<Button Content="Скачать"
                                HorizontalAlignment="Left"
                                Padding="8 2"
                                Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding}" />-->
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
    

    <Style x:Key="TransparentListViewItemStyle"
           TargetType="{x:Type ListViewItem}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="Transparent"/>
            </Trigger>

            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground"
                        Value="{Binding RelativeSource={RelativeSource Self},
                                        Path=Foreground}"/>
            </Trigger>

            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Trigger>

        </Style.Triggers>
    </Style>

</ResourceDictionary>